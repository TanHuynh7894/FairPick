# Copy to .env.local. Leave out a contract you did not deploy and its section shows how to add it.
# The values below are the live Fuji deployment (see README). ./scripts/fuji-deploy.sh writes this file for your own.
VITE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
VITE_ORACLE_ADDRESS=0xa4c1019b76EE5bEB9aFe641AAcf164b787b037Dd
VITE_SAMPLER_ADDRESS=0x415eaC3a64111E68DB8136660CD7Ff06F9F4f654
VITE_BEACON_ADDRESS=0x60198D44a183d313B5EAa432F85D184cab9F217C
# The ICM adapter that files audits from the fairpick L1 with the oracle (the "From L1" page).
VITE_ICM_ADAPTER=0x1C2ee9B10369F8459F07A933590598C6076E11CE
# Optional. The nodes to ask which key shares signed an answer, and the auditor to suggest in New audit.
# VITE_NODE_URLS=http://127.0.0.1:8701,http://127.0.0.1:8702,http://127.0.0.1:8703
# VITE_AUDITOR=0xE46D2346fc554940E40eE85F4f7fECdB092B3183
# VITE_TEST_KEYS=treasurer:0x…,auditor:0x…   testnet keys for a recording; read by the dev server only, and
#                                             `npm run build` refuses to run while set. scripts/pre-record.sh writes it.
